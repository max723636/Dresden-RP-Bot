const { Client, GatewayIntentBits, PermissionsBitField } = require("discord.js");

const client = new Client({
  intents: [
    GatewayIntentBits.Guilds,
    GatewayIntentBits.GuildMessages,
    GatewayIntentBits.MessageContent,
    GatewayIntentBits.GuildMembers
  ]
});

const PREFIX = "!";

client.on("ready", () => {
  console.log(`Online als ${client.user.tag}`);
});

client.on("messageCreate", async (message) => {
  if (message.author.bot) return;
  if (!message.content.startsWith(PREFIX)) return;

  const args = message.content.slice(PREFIX.length).split(" ");
  const command = args.shift().toLowerCase();

  // 🧹 CLEAR
  if (command === "clear") {
    if (!message.member.permissions.has(PermissionsBitField.Flags.ManageMessages)) {
      return message.reply("Keine Rechte!");
    }

    const amount = args[0];
    if (!amount) return message.reply("Zahl angeben!");

    await message.channel.bulkDelete(amount);
    message.channel.send(`🧹 ${amount} Nachrichten gelöscht!`).then(msg => {
      setTimeout(() => msg.delete(), 3000);
    });
  }

  // 👢 KICK
  if (command === "kick") {
    if (!message.member.permissions.has(PermissionsBitField.Flags.KickMembers)) {
      return message.reply("Keine Rechte!");
    }

    const member = message.mentions.members.first();
    if (!member) return message.reply("User erwähnen!");

    member.kick();
    message.channel.send(`${member.user.tag} wurde gekickt!`);
  }

  // 🔨 BAN
  if (command === "ban") {
    if (!message.member.permissions.has(PermissionsBitField.Flags.BanMembers)) {
      return message.reply("Keine Rechte!");
    }

    const member = message.mentions.members.first();
    if (!member) return message.reply("User erwähnen!");

    member.ban();
    message.channel.send(`${member.user.tag} wurde gebannt!`);
  }

  // 🔇 MUTE
  if (command === "mute") {
    if (!message.member.permissions.has(PermissionsBitField.Flags.ModerateMembers)) {
      return message.reply("Keine Rechte!");
    }

    const member = message.mentions.members.first();
    if (!member) return message.reply("User erwähnen!");

    await member.timeout(10 * 60 * 1000); // 10 Minuten
    message.channel.send(`${member.user.tag} wurde gemutet!`);
  }

  // ⚠️ WARN
  if (command === "warn") {
    if (!message.member.permissions.has(PermissionsBitField.Flags.ModerateMembers)) {
      return message.reply("Keine Rechte!");
    }

    const member = message.mentions.members.first();
    if (!member) return message.reply("User erwähnen!");

    const reason = args.slice(1).join(" ") || "Kein Grund";

    member.send(`⚠️ Du wurdest verwarnt: ${reason}`).catch(() => {});
    message.channel.send(`${member.user.tag} wurde verwarnt!`);
  }
});

