@discordBot.tree.command(
    name="send_embed",
    description="Sendet einen Embed mit allen Optionen"
)
async def send_embed(
    interaction: discord.Interaction,
    title: str,
    description: str,
    color: str = None,
    image_url: str = None,
    author: str = None,
    show_timestamp: bool = False
):

    try:
        embed_color = int(color.lstrip("#"), 16) if color else 0xFF0000
    except:
        embed_color = 0xFF0000

    embed = discord.Embed(
        title=title,
        description=description,
        color=embed_color
    )

    if image_url:
        embed.set_image(url=image_url)

    footer_text = ""

    if author:
        footer_text += f"{author}"

    if show_timestamp:
        if footer_text:
            footer_text += " | "
        footer_text += interaction.created_at.strftime("%d.%m.%Y %H:%M")

    if footer_text:
        embed.set_footer(text=footer_text)

    await interaction.response.send_message(embed=embed)


